# ---- Copy to .env and fill in. Never commit .env. ----
# How people sign in:
#   email = work-email sign-in for internal demos (default). Anyone can enter any non-admin email: it does NOT verify identity.
#   oidc  = company single sign-on (Azure AD / Okta / Google). Use this for real data.
#   dev   = local test picker with seeded users. Local machine only.
AUTH_MODE=email

# Administrators are named here and sign in with the password below (email mode).
ADMIN_EMAILS=you@company.com
# FIRST_ADMIN_EMAIL=   # older name for one extra administrator email; same effect as adding it to ADMIN_EMAILS
ADMIN_PASSWORD=choose-a-long-password

# Optional: only accept emails from this domain
ALLOWED_EMAIL_DOMAIN=company.com

# Optional: otherwise a random secret is created once in data/.session_secret
# SESSION_SECRET=
HTTPS_ONLY=1

# SQLite (default, nothing to set) or PostgreSQL for a shared server
# DATABASE_URL=postgresql+psycopg2://user:password@dbhost:5432/margin

# Demo mode (email and dev modes): creates 6 practice projects and one-click DEMO accounts on the sign-in page
# (demoadmin@demo.example, demo1projectmanager@..., demo1delmanager@... and so on). The demo administrator needs NO password.
# Set to 0 before real data is entered, so nobody can walk in as an administrator.
DEMO_DATA=1

# ---- Only for AUTH_MODE=oidc ----
# OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# DEFAULT_ROLE=manager

# ---- Genus table approval ----
# A new Genus table must be approved by a DIFFERENT administrator than the one who uploaded it.
# Set to 1 only for a single-administrator pilot, so the uploader can approve their own upload.
ALLOW_SELF_APPROVAL=0

# ---- Feedback (the "Send feedback" button) ----
# Feedback is always saved in data/feedback.jsonl. To also have it emailed, give the app a mail server.
# Without SMTP_HOST the page offers the person a ready-made email from their own mail program instead.
# FEEDBACK_TO=abhishek.srivastava04@nagarro.com
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=margin-calculator@company.com
